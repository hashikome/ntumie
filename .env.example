# Every key this product reads. Copy it, fill in what fits that environment and
# keep the copy out of the repository. Never use the placeholders live.
# Local development uses apps/api/.env and apps/web/.env.local; see the local runbook.

# --- Stack inputs: what a release gives docker-stack.prod.yml ---
PUBLIC_HOST=ntumie.link
INGRESS_NETWORK=dokploy-network
BACKEND_NETWORK=SET_SHARED_PRODUCT_DATA_NETWORK
HTTPS_ENTRYPOINT=websecure
TLS_RESOLVER=letsencrypt
TRUSTED_PROXY_CIDRS=SET_VERIFIED_PROXY_ADDRESSES
API_IMAGE=SET_RELEASE_API_SHA_AND_DIGEST
WEB_IMAGE=SET_RELEASE_WEB_SHA_AND_DIGEST
RELEASE_SHA=SET_FULL_RELEASE_COMMIT
RELEASE_ATTEMPT=SET_GITHUB_RUN_ID_AND_ATTEMPT
# Remain at zero until the release verifies a successful migration task.
APP_REPLICAS=0
QUEUE_NAMESPACE=ntumie-email
EMAIL_SUPPORT_URL=https://ntumie.link/support
# Sender/domain and support inbox delivery were accepted on 12 October 2026.
# hello@ntumie.link is for general enquiries; SUPPORT_EMAIL handles user help.
EMAIL_FROM_ADDRESS=ntumie. <no-reply@notify.ntumie.link>
SUPPORT_EMAIL=support@ntumie.link
BOOTSTRAP_ADMIN_EMAIL=
# Enable only after the production Google callback is configured and accepted.
GOOGLE_AUTH_ENABLED=false

# --- Docker secret NAMES (<product>_<name>_YYYYMMDD_vN); values never go here ---
DATABASE_URL_SECRET=SET_NTUMIE_RUNTIME_URL_SECRET
MIGRATION_DATABASE_URL_SECRET=SET_NTUMIE_MIGRATION_URL_SECRET
AUTH_SECRET=SET_NTUMIE_AUTH_SECRET
REDIS_URL_SECRET=SET_NTUMIE_SCOPED_QUEUE_URL_SECRET
WEB_SOURCE_SECRET_NAME=SET_NTUMIE_WEB_SOURCE_SECRET
GOOGLE_CLIENT_ID_SECRET=SET_NTUMIE_GOOGLE_ID_SECRET
GOOGLE_CLIENT_SECRET_NAME=SET_NTUMIE_GOOGLE_CLIENT_SECRET
RESEND_API_KEY_SECRET=SET_NTUMIE_SEND_KEY_SECRET
EMAIL_SUPPRESSION_SECRET_NAME=SET_NTUMIE_STABLE_SUPPRESSION_SECRET
SENTRY_DSN_SECRET=SET_NTUMIE_SENTRY_DSN_SECRET

# --- Running without the stack: plain values, or <NAME>_FILE for any secret ---
# A set <NAME>_FILE wins; an unreadable or empty file fails startup.
NODE_ENV=production
DATABASE_URL=postgresql://runtime:REPLACE@hashikome-products-postgres:5432/ntumie
REDIS_URL=redis://ntumie:REPLACE@hashikome-products-queue:6379/0
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
EMAIL_SUPPRESSION_SECRET=REPLACE_WITH_A_STABLE_RANDOM_SECRET
WEB_SOURCE_SECRET=REPLACE_WITH_A_RANDOM_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_THE_PRODUCT_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_THE_PRODUCT_CLIENT_SECRET
RESEND_API_KEY=REPLACE_WITH_A_SEND_ONLY_KEY
SENTRY_DSN=
BETTER_AUTH_URL=https://ntumie.link
WEB_ORIGIN=https://ntumie.link
API_INTERNAL_ORIGIN=http://api:4000
EMAIL_PROVIDER=resend
WEB_TRUSTED_PROXY_CIDRS=REPLACE_WITH_VERIFIED_PROXY_CIDRS
# The migration task receives its separate migrator DATABASE_URL_FILE.
# Never give the running application administrator or migrator credentials.
